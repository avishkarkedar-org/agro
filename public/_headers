# Cache-Control headers for static hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# PWA service worker + entry HTML + manifest must NOT be cached by the CDN or
# browser. Otherwise a new deploy stays invisible because the stale service
# worker keeps serving the old cached bundle until the user manually clears
# site data. These files are tiny, so revalidating every load is cheap.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/registerSW.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Global security and privacy headers for all files
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # R151: camera was "camera=()" - an empty allowlist disables the Camera API
  # for EVERY origin, including this site itself. That is a hard browser-level
  # block that happens before any JavaScript runs, so AgroIntelScan's
  # getUserMedia() call was rejected instantly and silently - no native
  # "Allow camera access?" prompt ever had a chance to appear. This is why
  # the site looked like it was "not asking for camera permission": the
  # browser was never allowed to ask. Changed to "camera=(self)" so only this
  # site (not third-party iframes) can request it, matching how microphone
  # and geolocation were already scoped on this same line.
  Permissions-Policy: microphone=(self), camera=(self), geolocation=(self)
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
